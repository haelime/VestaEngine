#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];
layout(set = 0, binding = 2, std430) readonly buffer StorageBufferUvec4 {
    uvec4 values[];
} storageBuffersUvec4[];

layout(push_constant) uniform RestirDiResolvePushConstants {
    uvec4 imageIndices;    // albedo, normal, material, depth
    uvec4 outputIndices;   // output image, reservoir buffer, constants buffer, frame index
    uvec4 dispatchParams;  // width, height, reservoirs per pixel, candidate lights
    uvec4 lightParams;     // active lights, local lights, emissive tris, enabled local flags
} pc;

const uint INVALID_RESOURCE_INDEX = 0xffffffffu;
const float PI = 3.14159265359;

uint hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

vec3 idColor(uint id)
{
    return vec3(
        float(hash(id * 3u + 1u) & 255u),
        float(hash(id * 5u + 7u) & 255u),
        float(hash(id * 11u + 13u) & 255u)) / 255.0;
}

vec4 unpackConstant(uint offset)
{
    uvec4 packed = storageBuffersUvec4[nonuniformEXT(int(pc.outputIndices.z))].values[offset];
    return vec4(uintBitsToFloat(packed.x), uintBitsToFloat(packed.y), uintBitsToFloat(packed.z), uintBitsToFloat(packed.w));
}

mat4 inverseViewProjection()
{
    return mat4(unpackConstant(0u), unpackConstant(1u), unpackConstant(2u), unpackConstant(3u));
}

vec3 reconstructWorldPosition(ivec2 pixel, ivec2 size, float depth)
{
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = inverseViewProjection() * vec4(ndc, depth, 1.0);
    return world.xyz / max(world.w, 1.0e-4);
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denominator = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / max(PI * denominator * denominator, 1.0e-4);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, 1.0e-4);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 evaluatePbrLight(vec3 baseColor, float metallic, float roughness, vec3 N, vec3 V, vec3 L, vec3 radiance)
{
    vec3 H = normalize(V + L);
    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    vec3 F0 = mix(vec3(0.04), baseColor, metallic);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);
    float D = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 specular = (D * G * F) / max(4.0 * NdotV * NdotL, 1.0e-4);
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 diffuse = kD * baseColor / PI;
    return (diffuse + specular) * radiance * NdotL;
}

bool resolveLocalSlot(inout uint slot, uint flagBit)
{
    if ((pc.lightParams.w & flagBit) == 0u) {
        return false;
    }
    if (slot == 1u) {
        return true;
    }
    slot -= 1u;
    return false;
}

vec3 evaluateSelectedLight(uint selectedLight, vec3 baseColor, float metallic, float roughness, vec3 worldPosition, vec3 normal, vec3 viewDirection)
{
    vec4 lightDirectionAndIntensity = unpackConstant(5u);
    vec3 direction = normalize(-lightDirectionAndIntensity.xyz);
    if (selectedLight == 0u) {
        return evaluatePbrLight(baseColor,
            metallic,
            roughness,
            normal,
            viewDirection,
            direction,
            max(unpackConstant(6u).rgb, vec3(0.0)) * lightDirectionAndIntensity.w);
    }

    uint localSlot = selectedLight;
    if (resolveLocalSlot(localSlot, 1u)) {
        vec4 pointPositionAndIntensity = unpackConstant(7u);
        vec3 delta = pointPositionAndIntensity.xyz - worldPosition;
        float distanceToLight = max(length(delta), 1.0e-4);
        float attenuation = 1.0 / max(distanceToLight * distanceToLight, 0.05);
        return evaluatePbrLight(baseColor,
            metallic,
            roughness,
            normal,
            viewDirection,
            delta / distanceToLight,
            max(unpackConstant(8u).rgb, vec3(0.0)) * pointPositionAndIntensity.w * attenuation);
    }
    if (resolveLocalSlot(localSlot, 2u)) {
        vec4 spotPositionAndIntensity = unpackConstant(9u);
        vec4 spotDirectionAndParams = unpackConstant(10u);
        vec3 delta = spotPositionAndIntensity.xyz - worldPosition;
        float distanceToLight = max(length(delta), 1.0e-4);
        vec3 spotL = delta / distanceToLight;
        float outerCos = cos(clamp(spotDirectionAndParams.w, 0.05, 1.55));
        float innerCos = cos(clamp(spotDirectionAndParams.w, 0.05, 1.55) * 0.78);
        float cone = smoothstep(outerCos, innerCos, dot(normalize(worldPosition - spotPositionAndIntensity.xyz), normalize(spotDirectionAndParams.xyz)));
        float attenuation = cone / max(distanceToLight * distanceToLight, 0.05);
        return evaluatePbrLight(baseColor,
            metallic,
            roughness,
            normal,
            viewDirection,
            spotL,
            max(unpackConstant(11u).rgb, vec3(0.0)) * spotPositionAndIntensity.w * attenuation);
    }
    if (resolveLocalSlot(localSlot, 4u)) {
        vec4 areaPositionAndIntensity = unpackConstant(12u);
        vec4 areaNormalAndSize = unpackConstant(13u);
        vec3 delta = areaPositionAndIntensity.xyz - worldPosition;
        float distanceToLight = max(length(delta), 1.0e-4);
        vec3 areaL = delta / distanceToLight;
        float facing = max(dot(normalize(areaNormalAndSize.xyz), -areaL), 0.0);
        float size = max(areaNormalAndSize.w, 0.1);
        float attenuation = facing * size * size / max(distanceToLight * distanceToLight + size * size, 0.05);
        return evaluatePbrLight(baseColor,
            metallic,
            roughness,
            normal,
            viewDirection,
            areaL,
            max(unpackConstant(14u).rgb, vec3(0.0)) * areaPositionAndIntensity.w * attenuation);
    }

    vec3 emissiveTint = mix(vec3(1.0, 0.72, 0.42), idColor(selectedLight + 17u), 0.28);
    float horizon = clamp(normal.y * 0.5 + 0.5, 0.0, 1.0);
    return baseColor * emissiveTint * (0.08 + 0.18 * horizon);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storageImages[nonuniformEXT(int(pc.outputIndices.x))]);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float depth = texture(sampledImages[nonuniformEXT(int(pc.imageIndices.w))], uv).r;
    if (depth >= 0.99999 || pc.outputIndices.y == INVALID_RESOURCE_INDEX || pc.outputIndices.z == INVALID_RESOURCE_INDEX) {
        imageStore(storageImages[nonuniformEXT(int(pc.outputIndices.x))], pixel, vec4(0.0));
        return;
    }

    vec4 albedoAo = imageLoad(storageImages[nonuniformEXT(int(pc.imageIndices.x))], pixel);
    vec4 normalRoughness = imageLoad(storageImages[nonuniformEXT(int(pc.imageIndices.y))], pixel);
    vec4 material = imageLoad(storageImages[nonuniformEXT(int(pc.imageIndices.z))], pixel);
    vec3 baseColor = max(albedoAo.rgb, vec3(0.0));
    vec3 normal = normalize(normalRoughness.xyz * 2.0 - 1.0);
    float roughness = clamp(normalRoughness.w, 0.045, 1.0);
    float metallic = clamp(material.a, 0.0, 1.0);
    vec3 worldPosition = reconstructWorldPosition(pixel, size, depth);
    vec3 cameraPosition = unpackConstant(4u).xyz;
    vec3 viewDirection = normalize(cameraPosition - worldPosition);

    uint reservoirsPerPixel = clamp(pc.dispatchParams.z, 1u, 8u);
    uint pixelIndex = uint(pixel.y) * uint(size.x) + uint(pixel.x);
    uint reservoirIndex = pixelIndex * reservoirsPerPixel;
    uvec4 reservoir = storageBuffersUvec4[nonuniformEXT(int(pc.outputIndices.y))].values[reservoirIndex];
    uint selectedLight = reservoir.x;
    float selectedWeight = uintBitsToFloat(reservoir.z);
    float weightSum = uintBitsToFloat(reservoir.w);
    float candidateCount = float(max(reservoir.y, 1u));
    vec4 resolveParams = unpackConstant(15u);
    float normalizedWeight = clamp(weightSum / candidateCount, 0.0, 4.0) * clamp(selectedWeight, 0.0, 4.0);

    vec3 contribution = evaluateSelectedLight(selectedLight, baseColor, metallic, roughness, worldPosition, normal, viewDirection)
        * normalizedWeight * resolveParams.x;
    if (resolveParams.y > 0.5) {
        contribution = vec3(clamp(weightSum / max(float(pc.dispatchParams.w), 1.0), 0.0, 1.0));
    } else if (resolveParams.z > 0.5) {
        contribution = idColor(selectedLight);
    }

    imageStore(storageImages[nonuniformEXT(int(pc.outputIndices.x))], pixel, vec4(contribution, 1.0));
}
