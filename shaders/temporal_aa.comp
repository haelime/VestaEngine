#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];

layout(push_constant) uniform TemporalAAPushConstants {
    uint inputImageIndex;
    uint outputImageIndex;
    uint normalImageIndex;
    uint materialImageIndex;
    uint depthImageIndex;
    uint motionImageIndex;
    uint reactiveImageIndex;
    uint historyReadImageIndex;
    uint frameIndex;
    float feedback;
    uint enabled;
    uint debugView;
    float sharpness;
    uint materialReactiveMask;
    float reactiveMaskStrength;
    float reactiveMetallicThreshold;
    float reactiveEmissiveThreshold;
    uint historyWriteImageIndex;
    mat4 inverseViewProjection;
    mat4 previousViewProjection;
} pc;

const uint DEBUG_TEMPORAL_HISTORY_COLOR = 22u;
const uint DEBUG_TEMPORAL_HISTORY_DEPTH = 23u;
const uint DEBUG_TEMPORAL_REPROJECTION = 24u;
const uint DEBUG_TEMPORAL_DISOCCLUSION = 25u;
const uint DEBUG_TEMPORAL_JITTER = 26u;
const uint INVALID_RESOURCE_INDEX = 0xffffffffu;

vec3 clampHistoryToNeighborhood(ivec2 pixel, ivec2 size, vec3 historyColor)
{
    vec3 minColor = vec3(1.0e20);
    vec3 maxColor = vec3(-1.0e20);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 samplePixel = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
            vec3 sampleColor = imageLoad(storageImages[nonuniformEXT(int(pc.inputImageIndex))], samplePixel).rgb;
            minColor = min(minColor, sampleColor);
            maxColor = max(maxColor, sampleColor);
        }
    }
    return clamp(historyColor, minColor, maxColor);
}

vec3 reconstructWorldPosition(vec2 uv, float depth)
{
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = pc.inverseViewProjection * vec4(ndc, depth, 1.0);
    return world.xyz / max(world.w, 0.0001);
}

float halton(uint index, uint base)
{
    float result = 0.0;
    float fraction = 1.0 / float(base);
    uint value = index;
    while (value > 0u) {
        result += float(value % base) * fraction;
        value /= base;
        fraction /= float(base);
    }
    return result;
}

vec3 heatmap(float value)
{
    value = clamp(value, 0.0, 1.0);
    vec3 blue = vec3(0.05, 0.12, 0.85);
    vec3 cyan = vec3(0.0, 0.85, 0.95);
    vec3 yellow = vec3(1.0, 0.9, 0.05);
    vec3 red = vec3(1.0, 0.08, 0.02);
    if (value < 0.33) {
        return mix(blue, cyan, value / 0.33);
    }
    if (value < 0.66) {
        return mix(cyan, yellow, (value - 0.33) / 0.33);
    }
    return mix(yellow, red, (value - 0.66) / 0.34);
}

float luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 jitterDebugColor(vec2 uv)
{
    vec2 jitter = vec2(halton((pc.frameIndex & 1023u) + 1u, 2u), halton((pc.frameIndex & 1023u) + 1u, 3u)) - 0.5;
    vec2 shifted = uv + jitter / vec2(32.0, 18.0);
    vec2 grid = abs(fract(shifted * vec2(32.0, 18.0)) - 0.5);
    float line = smoothstep(0.46, 0.50, max(grid.x, grid.y));
    return mix(vec3(jitter + 0.5, 0.35), vec3(1.0, 0.95, 0.25), line);
}

vec3 loadInputColor(ivec2 pixel, ivec2 size)
{
    ivec2 clampedPixel = clamp(pixel, ivec2(0), size - ivec2(1));
    return imageLoad(storageImages[nonuniformEXT(int(pc.inputImageIndex))], clampedPixel).rgb;
}

vec3 sharpenUpscaledColor(vec3 color, ivec2 inputPixel, ivec2 inputSize)
{
    if (pc.sharpness <= 0.0) {
        return color;
    }

    vec3 blur = loadInputColor(inputPixel, inputSize) * 0.4;
    blur += loadInputColor(inputPixel + ivec2(1, 0), inputSize) * 0.15;
    blur += loadInputColor(inputPixel + ivec2(-1, 0), inputSize) * 0.15;
    blur += loadInputColor(inputPixel + ivec2(0, 1), inputSize) * 0.15;
    blur += loadInputColor(inputPixel + ivec2(0, -1), inputSize) * 0.15;
    return max(color + (color - blur) * pc.sharpness, vec3(0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storageImages[nonuniformEXT(int(pc.outputImageIndex))]);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    ivec2 inputSize = imageSize(storageImages[nonuniformEXT(int(pc.inputImageIndex))]);
    ivec2 inputPixel = clamp(ivec2(uv * vec2(inputSize)), ivec2(0), inputSize - ivec2(1));
    ivec2 normalSize = imageSize(storageImages[nonuniformEXT(int(pc.normalImageIndex))]);
    ivec2 normalPixel = clamp(ivec2(uv * vec2(normalSize)), ivec2(0), normalSize - ivec2(1));
    ivec2 motionSize = imageSize(storageImages[nonuniformEXT(int(pc.motionImageIndex))]);
    ivec2 motionPixel = clamp(ivec2(uv * vec2(motionSize)), ivec2(0), motionSize - ivec2(1));

    vec3 currentColor = loadInputColor(inputPixel, inputSize);
    vec4 normalRoughness = imageLoad(storageImages[nonuniformEXT(int(pc.normalImageIndex))], normalPixel);
    vec4 materialSignal = pc.materialImageIndex != INVALID_RESOURCE_INDEX
        ? imageLoad(storageImages[nonuniformEXT(int(pc.materialImageIndex))], normalPixel)
        : vec4(0.0);
    vec4 reactiveSignal = pc.reactiveImageIndex != INVALID_RESOURCE_INDEX
        ? imageLoad(storageImages[nonuniformEXT(int(pc.reactiveImageIndex))], normalPixel)
        : vec4(0.0);
    vec3 currentNormal = normalize(normalRoughness.xyz * 2.0 - 1.0);
    float currentDepth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], uv).r;
    vec3 temporalColor = currentColor;
    vec2 previousUv = uv;
    bool validHistory = false;
    vec4 history = vec4(currentColor, currentDepth);
    float confidence = 0.0;
    float reactiveMask = 1.0;
    bool wantsHistory = pc.enabled != 0u || (pc.debugView >= DEBUG_TEMPORAL_HISTORY_COLOR && pc.debugView <= DEBUG_TEMPORAL_JITTER);
    if (wantsHistory && pc.frameIndex > 0u && currentDepth < 0.99999) {
        vec2 motion = imageLoad(storageImages[nonuniformEXT(int(pc.motionImageIndex))], motionPixel).xy;
        previousUv = uv - motion;
        if (dot(motion, motion) <= 1.0e-10) {
            vec3 worldPosition = reconstructWorldPosition(uv, currentDepth);
            vec4 previousClip = pc.previousViewProjection * vec4(worldPosition, 1.0);
            vec3 previousNdc = previousClip.xyz / max(previousClip.w, 0.0001);
            previousUv = previousNdc.xy * 0.5 + 0.5;
        }
        validHistory = previousUv.x >= 0.0 && previousUv.y >= 0.0 && previousUv.x <= 1.0 && previousUv.y <= 1.0;
        ivec2 historyPixel = clamp(ivec2(previousUv * vec2(size)), ivec2(0), size - ivec2(1));
        history = imageLoad(storageImages[nonuniformEXT(int(pc.historyReadImageIndex))], historyPixel);
        vec3 historyColor = clampHistoryToNeighborhood(inputPixel, inputSize, history.rgb);
        float historyDepth = history.a;
        float depthDelta = abs(currentDepth - historyDepth);
        float depthAgreement = smoothstep(0.025, 0.001, depthDelta);
        float normalConfidence = smoothstep(0.72, 0.98, max(currentNormal.z * currentNormal.z, 0.0));
        confidence = (validHistory ? 1.0 : 0.0) * depthAgreement * mix(0.55, 1.0, normalConfidence);
        float currentLuma = luminance(currentColor);
        float historyLuma = luminance(historyColor);
        float luminanceReactive = smoothstep(0.08, 0.45, abs(currentLuma - historyLuma));
        float motionReactive = smoothstep(0.004, 0.065, length(motion));
        float depthReactive = 1.0 - depthAgreement;
        float materialReactive = 0.0;
        if (pc.materialReactiveMask != 0u) {
            float metallicReactive = smoothstep(pc.reactiveMetallicThreshold, 1.0, materialSignal.a)
                * (1.0 - smoothstep(0.18, 0.75, normalRoughness.w));
            float emissiveReactive = smoothstep(pc.reactiveEmissiveThreshold, pc.reactiveEmissiveThreshold * 8.0 + 1.0e-4,
                luminance(max(materialSignal.rgb, vec3(0.0))));
            float authoredAlphaReactive = clamp(reactiveSignal.r, 0.0, 1.0);
            materialReactive = max(max(metallicReactive, emissiveReactive), authoredAlphaReactive) * clamp(pc.reactiveMaskStrength, 0.0, 1.0);
        }
        reactiveMask = clamp(max(max(luminanceReactive, depthReactive), motionReactive * 0.6), 0.0, 1.0);
        reactiveMask = max(reactiveMask, materialReactive);
        float blend = clamp(pc.feedback * confidence * (1.0 - reactiveMask * 0.85), 0.0, 0.98);
        temporalColor = mix(currentColor, historyColor, blend);
    }

    if (inputSize.x != size.x || inputSize.y != size.y) {
        temporalColor = sharpenUpscaledColor(temporalColor, inputPixel, inputSize);
    }

    vec3 outputColor = temporalColor;
    if (pc.debugView == DEBUG_TEMPORAL_HISTORY_COLOR) {
        outputColor = history.rgb;
    } else if (pc.debugView == DEBUG_TEMPORAL_HISTORY_DEPTH) {
        outputColor = vec3(clamp(history.a, 0.0, 1.0));
    } else if (pc.debugView == DEBUG_TEMPORAL_REPROJECTION) {
        outputColor = vec3(clamp(previousUv, vec2(0.0), vec2(1.0)), validHistory ? 1.0 : 0.0);
    } else if (pc.debugView == DEBUG_TEMPORAL_DISOCCLUSION) {
        outputColor = heatmap(max(1.0 - confidence, reactiveMask));
    } else if (pc.debugView == DEBUG_TEMPORAL_JITTER) {
        outputColor = jitterDebugColor(uv);
    }

    imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))], pixel, vec4(outputColor, 1.0));
    imageStore(storageImages[nonuniformEXT(int(pc.historyWriteImageIndex))], pixel, vec4(temporalColor, currentDepth));
}
