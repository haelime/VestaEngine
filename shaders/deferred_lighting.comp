#version 460
#extension GL_EXT_nonuniform_qualifier : enable

// Deferred lighting compute pass with a small glTF metallic-roughness BRDF.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];

struct DeferredLightingConstants {
    mat4 lightViewProjection;
    mat4 cascadeViewProjections[4];
    vec4 cascadeSplits;
    vec4 cascadeAtlasScaleOffsets[4];
    vec4 shadowParams;
    vec4 shadowFilterParams;
    vec4 contactShadowParams;
    uvec4 shadowIndices;
    vec4 directionalColor;
    vec4 pointPositionAndIntensity;
    vec4 pointColor;
    vec4 spotPositionAndIntensity;
    vec4 spotDirectionAndParams;
    vec4 spotColor;
    vec4 areaPositionAndIntensity;
    vec4 areaNormalAndSize;
    vec4 areaColor;
};

layout(set = 0, binding = 2, std430) readonly buffer DeferredLightingConstantsBuffer {
    DeferredLightingConstants values;
} lightingConstantsBuffers[];

layout(push_constant) uniform DeferredLightingPushConstants {
    uint albedoImageIndex;
    uint normalImageIndex;
    uint materialImageIndex;
    uint depthImageIndex;
    uint outputImageIndex;
    uint debugOutputImageIndex;
    uint debugView;
    uint lightingConstantsBufferIndex;
    mat4 inverseViewProjection;
    mat4 viewProjection;
    vec4 cameraPosition;
    vec4 lightDirectionAndIntensity;
    vec4 environmentParams;
    vec4 ssaoParams;
    vec4 ssrParams;
    vec4 ssgiParams;
} pc;

const float PI = 3.14159265359;
const uint INVALID_IMAGE_INDEX = 0xffffffffu;
const uint DEBUG_DIRECT_LIGHTING = 13u;
const uint DEBUG_INDIRECT_LIGHTING = 14u;
const uint DEBUG_REFLECTION = 15u;
const uint DEBUG_CONTACT_SHADOW = 27u;
const uint INVALID_BUFFER_INDEX = 0xffffffffu;

vec3 sampleEnvironmentMap(uint imageIndex, vec3 direction)
{
    float u = atan(direction.z, direction.x) / (2.0 * PI) + 0.5;
    float v = acos(clamp(direction.y, -1.0, 1.0)) / PI;
    return texture(sampledImages[nonuniformEXT(int(imageIndex))], vec2(u, v)).rgb * pc.environmentParams.x;
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denominator = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / max(PI * denominator * denominator, 1.0e-4);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, 1.0e-4);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 sampleSky(vec3 direction)
{
    float c = cos(pc.environmentParams.y);
    float s = sin(pc.environmentParams.y);
    direction = normalize(vec3(c * direction.x + s * direction.z, direction.y, -s * direction.x + c * direction.z));
    uint environmentImageIndex = pc.lightingConstantsBufferIndex != INVALID_BUFFER_INDEX
        ? lightingConstantsBuffers[nonuniformEXT(int(pc.lightingConstantsBufferIndex))].values.shadowIndices.y
        : INVALID_IMAGE_INDEX;
    if (environmentImageIndex != INVALID_IMAGE_INDEX) {
        return sampleEnvironmentMap(environmentImageIndex, direction);
    }
    float skyT = 0.5 * (direction.y + 1.0);
    uint preset = uint(clamp(pc.environmentParams.z + 0.5, 0.0, 3.0));
    vec3 horizon = vec3(0.08, 0.11, 0.16);
    vec3 zenith = vec3(0.40, 0.55, 0.82);
    vec3 sunColor = vec3(1.35, 0.92, 0.45);
    if (preset == 1u) {
        horizon = vec3(0.20, 0.18, 0.16);
        zenith = vec3(0.78, 0.62, 0.38);
        sunColor = vec3(1.85, 0.88, 0.38);
    } else if (preset == 2u) {
        horizon = vec3(0.025, 0.032, 0.048);
        zenith = vec3(0.12, 0.17, 0.26);
        sunColor = vec3(0.48, 0.66, 1.15);
    } else if (preset == 3u) {
        horizon = vec3(0.12, 0.14, 0.13);
        zenith = vec3(0.36, 0.44, 0.38);
        sunColor = vec3(0.74, 0.86, 0.68);
    }
    vec3 sky = mix(horizon, zenith, skyT);
    float sunPower = preset == 2u ? 96.0 : 64.0;
    float sun = pow(max(dot(direction, normalize(vec3(0.55, 0.25, 0.80))), 0.0), sunPower);
    return (sky + sun * sunColor) * pc.environmentParams.x;
}

vec3 sampleDiffuseIbl(vec3 normal)
{
    float strength = clamp(pc.environmentParams.w, 0.0, 2.0);
    vec3 bentNormal = normalize(mix(normal, vec3(0.0, 1.0, 0.0), 0.18));
    return sampleSky(bentNormal) * strength;
}

vec3 sampleSpecularIbl(vec3 reflectionDirection, float roughness)
{
    float strength = clamp(pc.ssaoParams.w, 0.0, 2.0);
    vec3 blurredDirection = normalize(mix(reflectionDirection, vec3(0.0, 1.0, 0.0), clamp(roughness * 0.75, 0.0, 0.85)));
    return mix(sampleSky(reflectionDirection), sampleSky(blurredDirection), clamp(roughness, 0.0, 1.0)) * strength;
}

vec3 evaluatePbrLight(vec3 baseColor, float metallic, float roughness, vec3 N, vec3 V, vec3 L, vec3 radiance)
{
    vec3 H = normalize(V + L);
    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    vec3 F0 = mix(vec3(0.04), baseColor, metallic);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);
    float D = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 specular = (D * G * F) / max(4.0 * NdotV * NdotL, 1.0e-4);
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 diffuse = kD * baseColor / PI;
    return (diffuse + specular) * radiance * NdotL;
}

vec3 reconstructWorldPosition(ivec2 pixel, ivec2 size, float depth)
{
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = pc.inverseViewProjection * vec4(ndc, depth, 1.0);
    return world.xyz / max(world.w, 1.0e-4);
}

float computeScreenSpaceAo(ivec2 pixel, ivec2 size, vec3 worldPosition, vec3 normal, float depth)
{
    if (pc.ssaoParams.x < 0.5 || depth >= 0.99999) {
        return 1.0;
    }

    const vec2 offsets[12] = vec2[](
        vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0),
        vec2(0.707, 0.707), vec2(-0.707, 0.707), vec2(0.707, -0.707), vec2(-0.707, -0.707),
        vec2(0.383, 0.924), vec2(-0.924, 0.383), vec2(0.924, -0.383), vec2(-0.383, -0.924));

    float viewDistance = max(length(pc.cameraPosition.xyz - worldPosition), 0.25);
    float radiusPixels = clamp((pc.ssaoParams.y * 95.0) / viewDistance, 2.0, 48.0);
    float occlusion = 0.0;
    float weightSum = 0.0;

    for (int sampleIndex = 0; sampleIndex < 12; ++sampleIndex) {
        vec2 scaledOffset = offsets[sampleIndex] * radiusPixels * (0.45 + 0.11 * float(sampleIndex % 4));
        ivec2 samplePixel = clamp(pixel + ivec2(round(scaledOffset)), ivec2(0), size - ivec2(1));
        vec2 sampleUv = (vec2(samplePixel) + 0.5) / vec2(size);
        float sampleDepth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], sampleUv).r;
        if (sampleDepth >= 0.99999) {
            continue;
        }

        vec3 sampleWorld = reconstructWorldPosition(samplePixel, size, sampleDepth);
        vec3 delta = sampleWorld - worldPosition;
        float distanceToSample = length(delta);
        if (distanceToSample <= 1.0e-4 || distanceToSample > pc.ssaoParams.y) {
            continue;
        }

        vec3 sampleDirection = delta / distanceToSample;
        float hemisphereWeight = max(dot(normal, sampleDirection), 0.0);
        float rangeWeight = smoothstep(pc.ssaoParams.y, 0.0, distanceToSample);
        float depthBias = 0.0008;
        float isOccluder = sampleDepth < depth - depthBias ? 1.0 : 0.0;
        float weight = mix(0.35, 1.0, hemisphereWeight) * rangeWeight;
        occlusion += isOccluder * weight;
        weightSum += weight;
    }

    if (weightSum <= 0.0) {
        return 1.0;
    }

    float normalizedOcclusion = clamp(occlusion / weightSum, 0.0, 1.0);
    return clamp(1.0 - normalizedOcclusion * pc.ssaoParams.z, 0.0, 1.0);
}

vec3 sampleGBufferColor(ivec2 samplePixel)
{
    vec4 sampleAlbedoAo = imageLoad(storageImages[nonuniformEXT(int(pc.albedoImageIndex))], samplePixel);
    vec4 sampleMaterial = imageLoad(storageImages[nonuniformEXT(int(pc.materialImageIndex))], samplePixel);
    return max(sampleAlbedoAo.rgb, vec3(0.0)) * 0.65 + max(sampleMaterial.rgb, vec3(0.0));
}

vec3 computeScreenSpaceReflection(ivec2 pixel, ivec2 size, vec3 worldPosition, vec3 normal, vec3 viewDir, vec3 skyReflection, float roughness, float metallic)
{
    if (pc.ssrParams.x < 0.5 || roughness > 0.92) {
        return skyReflection;
    }

    vec3 reflectionDirection = normalize(reflect(-viewDir, normal));
    if (dot(reflectionDirection, normal) <= 0.0) {
        return skyReflection;
    }

    const int stepCount = 28;
    float maxDistance = max(pc.ssrParams.y, 0.5);
    float stride = maxDistance / float(stepCount);
    float thickness = max(pc.ssrParams.z, 0.01);
    vec3 rayOrigin = worldPosition + normal * 0.04;

    for (int stepIndex = 1; stepIndex <= stepCount; ++stepIndex) {
        vec3 rayPosition = rayOrigin + reflectionDirection * (stride * float(stepIndex));
        vec4 clip = pc.viewProjection * vec4(rayPosition, 1.0);
        if (clip.w <= 0.0) {
            break;
        }

        vec3 ndc = clip.xyz / clip.w;
        vec2 sampleUv = ndc.xy * 0.5 + 0.5;
        if (sampleUv.x < 0.0 || sampleUv.y < 0.0 || sampleUv.x > 1.0 || sampleUv.y > 1.0) {
            break;
        }

        ivec2 samplePixel = clamp(ivec2(sampleUv * vec2(size)), ivec2(0), size - ivec2(1));
        float sampleDepth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], sampleUv).r;
        if (sampleDepth >= 0.99999) {
            continue;
        }

        vec3 sampleWorld = reconstructWorldPosition(samplePixel, size, sampleDepth);
        float hitDistance = dot(sampleWorld - rayOrigin, reflectionDirection);
        float rayDistance = stride * float(stepIndex);
        float distanceError = rayDistance - hitDistance;
        if (distanceError >= 0.0 && distanceError < thickness + rayDistance * 0.025) {
            float edgeFade = smoothstep(0.0, 0.08, sampleUv.x) * smoothstep(1.0, 0.92, sampleUv.x)
                * smoothstep(0.0, 0.08, sampleUv.y) * smoothstep(1.0, 0.92, sampleUv.y);
            float roughnessFade = 1.0 - smoothstep(0.35, 0.95, roughness);
            float metalBoost = mix(0.35, 1.0, metallic);
            vec3 hitColor = sampleGBufferColor(samplePixel);
            return mix(skyReflection, hitColor, clamp(edgeFade * roughnessFade * metalBoost * pc.ssrParams.w, 0.0, 1.0));
        }
    }

    return skyReflection;
}

vec3 computeScreenSpaceGi(ivec2 pixel, ivec2 size, vec3 worldPosition, vec3 normal, vec3 baseColor)
{
    if (pc.ssgiParams.x < 0.5) {
        return vec3(0.0);
    }

    const vec2 offsets[16] = vec2[](
        vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0),
        vec2(0.707, 0.707), vec2(-0.707, 0.707), vec2(0.707, -0.707), vec2(-0.707, -0.707),
        vec2(0.383, 0.924), vec2(-0.924, 0.383), vec2(0.924, -0.383), vec2(-0.383, -0.924),
        vec2(0.195, 0.981), vec2(-0.981, 0.195), vec2(0.981, -0.195), vec2(-0.195, -0.981));

    float viewDistance = max(length(pc.cameraPosition.xyz - worldPosition), 0.25);
    float radiusPixels = clamp((pc.ssgiParams.y * 120.0) / viewDistance, 3.0, 72.0);
    int sampleCount = int(clamp(pc.ssgiParams.w, 4.0, 16.0));
    vec3 bounce = vec3(0.0);
    float weightSum = 0.0;

    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        vec2 scaledOffset = offsets[sampleIndex] * radiusPixels * (0.35 + 0.055 * float(sampleIndex));
        ivec2 samplePixel = clamp(pixel + ivec2(round(scaledOffset)), ivec2(0), size - ivec2(1));
        vec2 sampleUv = (vec2(samplePixel) + 0.5) / vec2(size);
        float sampleDepth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], sampleUv).r;
        if (sampleDepth >= 0.99999) {
            continue;
        }

        vec3 sampleWorld = reconstructWorldPosition(samplePixel, size, sampleDepth);
        vec3 delta = sampleWorld - worldPosition;
        float distanceToSample = length(delta);
        if (distanceToSample <= 1.0e-4 || distanceToSample > pc.ssgiParams.y) {
            continue;
        }

        vec4 sampleNormalRoughness = imageLoad(storageImages[nonuniformEXT(int(pc.normalImageIndex))], samplePixel);
        vec3 sampleNormal = normalize(sampleNormalRoughness.xyz * 2.0 - 1.0);
        vec3 sampleDirection = delta / distanceToSample;
        float receiverWeight = max(dot(normal, sampleDirection), 0.0);
        float emitterWeight = max(dot(sampleNormal, -sampleDirection), 0.0);
        float rangeWeight = smoothstep(pc.ssgiParams.y, 0.0, distanceToSample);
        vec3 sampleColor = sampleGBufferColor(samplePixel);
        float weight = receiverWeight * emitterWeight * rangeWeight;
        bounce += sampleColor * weight;
        weightSum += weight;
    }

    if (weightSum <= 0.0) {
        return vec3(0.0);
    }

    return (bounce / weightSum) * baseColor * pc.ssgiParams.z;
}

float computeDirectionalShadow(vec3 worldPosition, vec3 normal, vec3 lightDirection)
{
    if (pc.lightingConstantsBufferIndex == INVALID_BUFFER_INDEX) {
        return 1.0;
    }

    DeferredLightingConstants constants = lightingConstantsBuffers[nonuniformEXT(int(pc.lightingConstantsBufferIndex))].values;
    if (constants.shadowParams.w < 0.5 || constants.shadowIndices.x == INVALID_IMAGE_INDEX) {
        return 1.0;
    }

    uint cascadeCount = clamp(constants.shadowIndices.z, 1u, 4u);
    float viewDistance = length(worldPosition - pc.cameraPosition.xyz);
    uint cascadeIndex = cascadeCount - 1u;
    for (uint i = 0u; i < 4u; ++i) {
        if (i >= cascadeCount) {
            break;
        }
        if (viewDistance <= constants.cascadeSplits[i]) {
            cascadeIndex = i;
            break;
        }
    }

    float normalBias = constants.shadowParams.y;
    vec4 shadowClip = constants.cascadeViewProjections[cascadeIndex] * vec4(worldPosition + normal * normalBias, 1.0);
    if (shadowClip.w <= 0.0) {
        return 1.0;
    }

    vec3 shadowNdc = shadowClip.xyz / shadowClip.w;
    vec2 cascadeUv = shadowNdc.xy * 0.5 + 0.5;
    if (cascadeUv.x < 0.0 || cascadeUv.y < 0.0 || cascadeUv.x > 1.0 || cascadeUv.y > 1.0) {
        return 1.0;
    }
    vec4 atlasScaleOffset = constants.cascadeAtlasScaleOffsets[cascadeIndex];
    vec2 shadowUv = cascadeUv * atlasScaleOffset.xy + atlasScaleOffset.zw;

    vec2 texelSize = 1.0 / vec2(textureSize(sampledImages[nonuniformEXT(int(constants.shadowIndices.x))], 0));
    float slopeBias = constants.shadowParams.x * (1.0 - clamp(dot(normal, lightDirection), 0.0, 1.0));
    float receiverDepth = shadowNdc.z - max(constants.shadowParams.x, slopeBias);

    float filterRadius = clamp(constants.shadowFilterParams.x, 0.5, 4.0);
    if (constants.shadowFilterParams.y > 0.5) {
        float blockerDepthSum = 0.0;
        float blockerCount = 0.0;
        const int blockerRadius = 2;
        for (int y = -blockerRadius; y <= blockerRadius; ++y) {
            for (int x = -blockerRadius; x <= blockerRadius; ++x) {
                vec2 offset = vec2(x, y) * texelSize * max(filterRadius, 1.0);
                float blockerDepth = texture(sampledImages[nonuniformEXT(int(constants.shadowIndices.x))], shadowUv + offset).r;
                if (blockerDepth < receiverDepth) {
                    blockerDepthSum += blockerDepth;
                    blockerCount += 1.0;
                }
            }
        }
        if (blockerCount > 0.0) {
            float averageBlockerDepth = blockerDepthSum / blockerCount;
            float penumbra = clamp((receiverDepth - averageBlockerDepth) * 420.0, 1.0, 4.0);
            filterRadius *= penumbra;
        }
    }

    float visibility = 0.0;
    float weightSum = 0.0;
    const int maxKernelRadius = 4;
    for (int y = -maxKernelRadius; y <= maxKernelRadius; ++y) {
        for (int x = -maxKernelRadius; x <= maxKernelRadius; ++x) {
            float distanceToCenter = length(vec2(x, y));
            if (distanceToCenter > filterRadius + 0.35) {
                continue;
            }
            float weight = 1.0 - smoothstep(max(filterRadius - 1.0, 0.0), filterRadius + 0.35, distanceToCenter);
            float blockerDepth = texture(sampledImages[nonuniformEXT(int(constants.shadowIndices.x))],
                shadowUv + vec2(x, y) * texelSize).r;
            visibility += (receiverDepth <= blockerDepth ? 1.0 : 0.0) * weight;
            weightSum += weight;
        }
    }
    visibility /= max(weightSum, 1.0);
    return mix(1.0 - constants.shadowParams.z, 1.0, visibility);
}

float computeContactShadow(DeferredLightingConstants constants, ivec2 pixel, ivec2 size, vec3 worldPosition, vec3 normal, vec3 lightDirection, float depth)
{
    if (constants.contactShadowParams.x < 0.5 || depth >= 0.99999) {
        return 1.0;
    }

    float maxDistance = max(constants.contactShadowParams.y, 0.05);
    float intensity = clamp(constants.contactShadowParams.z, 0.0, 1.0);
    vec3 rayOrigin = worldPosition + normal * 0.015;
    const int stepCount = 14;

    for (int stepIndex = 1; stepIndex <= stepCount; ++stepIndex) {
        float rayDistance = maxDistance * (float(stepIndex) / float(stepCount));
        vec3 rayPosition = rayOrigin + lightDirection * rayDistance;
        vec4 clip = pc.viewProjection * vec4(rayPosition, 1.0);
        if (clip.w <= 0.0) {
            break;
        }

        vec3 ndc = clip.xyz / max(clip.w, 1.0e-4);
        vec2 sampleUv = ndc.xy * 0.5 + 0.5;
        if (sampleUv.x < 0.0 || sampleUv.y < 0.0 || sampleUv.x > 1.0 || sampleUv.y > 1.0) {
            break;
        }

        ivec2 samplePixel = clamp(ivec2(sampleUv * vec2(size)), ivec2(0), size - ivec2(1));
        float sampleDepth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], sampleUv).r;
        if (sampleDepth >= 0.99999 || samplePixel == pixel) {
            continue;
        }

        float depthBias = 0.00035 + rayDistance * 0.0009;
        if (sampleDepth < ndc.z - depthBias) {
            float fade = 1.0 - float(stepIndex - 1) / float(stepCount);
            return 1.0 - intensity * fade;
        }
    }

    return 1.0;
}

vec3 evaluateLocalLights(DeferredLightingConstants constants,
    vec3 baseColor,
    float metallic,
    float roughness,
    vec3 worldPosition,
    vec3 N,
    vec3 V)
{
    vec3 result = vec3(0.0);

    if (constants.spotPositionAndIntensity.w > 0.0) {
        vec3 spotPosition = constants.spotPositionAndIntensity.xyz;
        vec3 pointToLight = spotPosition - worldPosition;
        float distanceToLight = max(length(pointToLight), 1.0e-4);
        vec3 spotL = pointToLight / distanceToLight;
        vec3 spotDirection = normalize(constants.spotDirectionAndParams.xyz);
        float outerAngle = clamp(constants.spotDirectionAndParams.w, 0.05, 1.55);
        float outerCos = cos(outerAngle);
        float innerCos = cos(outerAngle * 0.78);
        float coneCos = dot(normalize(worldPosition - spotPosition), spotDirection);
        float cone = smoothstep(outerCos, innerCos, coneCos);
        float attenuation = cone / max(distanceToLight * distanceToLight, 0.08);
        result += evaluatePbrLight(baseColor,
            metallic,
            roughness,
            N,
            V,
            spotL,
            max(constants.spotColor.rgb, vec3(0.0)) * constants.spotPositionAndIntensity.w * attenuation);
    }

    if (constants.areaPositionAndIntensity.w > 0.0) {
        vec3 areaPosition = constants.areaPositionAndIntensity.xyz;
        vec3 pointToLight = areaPosition - worldPosition;
        float distanceToLight = max(length(pointToLight), 1.0e-4);
        vec3 areaL = pointToLight / distanceToLight;
        vec3 areaNormal = normalize(constants.areaNormalAndSize.xyz);
        float size = max(constants.areaNormalAndSize.w, 0.1);
        float facing = max(dot(areaNormal, -areaL), 0.0);
        float attenuation = facing * size * size / max(distanceToLight * distanceToLight + size * size, 0.08);
        result += evaluatePbrLight(baseColor,
            metallic,
            roughness,
            N,
            V,
            areaL,
            max(constants.areaColor.rgb, vec3(0.0)) * constants.areaPositionAndIntensity.w * attenuation);
    }

    return result;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storageImages[nonuniformEXT(int(pc.albedoImageIndex))]);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 albedoAo = imageLoad(storageImages[nonuniformEXT(int(pc.albedoImageIndex))], pixel);
    vec4 normalRoughness = imageLoad(storageImages[nonuniformEXT(int(pc.normalImageIndex))], pixel);
    vec4 emissiveMetallic = imageLoad(storageImages[nonuniformEXT(int(pc.materialImageIndex))], pixel);
    float depth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], uv).r;

    vec3 N = normalize(normalRoughness.xyz * 2.0 - 1.0);
    float roughness = clamp(normalRoughness.w, 0.045, 1.0);
    float metallic = clamp(emissiveMetallic.a, 0.0, 1.0);
    float ao = clamp(albedoAo.a, 0.0, 1.0);
    vec3 baseColor = max(albedoAo.rgb, vec3(0.0));
    vec3 emissive = max(emissiveMetallic.rgb, vec3(0.0));

    vec3 worldPosition = reconstructWorldPosition(pixel, size, depth);
    ao *= computeScreenSpaceAo(pixel, size, worldPosition, N, depth);
    vec3 V = normalize(pc.cameraPosition.xyz - worldPosition);
    vec3 L = normalize(-pc.lightDirectionAndIntensity.xyz);
    vec3 R = reflect(-V, N);

    vec3 F0 = mix(vec3(0.04), baseColor, metallic);
    DeferredLightingConstants lightingConstants = lightingConstantsBuffers[nonuniformEXT(int(pc.lightingConstantsBufferIndex))].values;
    vec3 direct = evaluatePbrLight(baseColor,
        metallic,
        roughness,
        N,
        V,
        L,
        max(lightingConstants.directionalColor.rgb, vec3(0.0)) * pc.lightDirectionAndIntensity.w);
    float shadowFactor = computeDirectionalShadow(worldPosition, N, L);
    float contactShadow = computeContactShadow(lightingConstants, pixel, size, worldPosition, N, L, depth);
    direct *= shadowFactor * contactShadow;
    direct += evaluateLocalLights(lightingConstants, baseColor, metallic, roughness, worldPosition, N, V);
    float pointIntensity = lightingConstants.pointPositionAndIntensity.w;
    if (pointIntensity > 0.0) {
        vec3 pointPosition = lightingConstants.pointPositionAndIntensity.xyz;
        vec3 pointDelta = pointPosition - worldPosition;
        float pointDistance = length(pointDelta);
        vec3 pointL = pointDelta / max(pointDistance, 1.0e-4);
        const float pointRadius = 8.0;
        float attenuation = pow(clamp(1.0 - pointDistance / pointRadius, 0.0, 1.0), 2.0) / max(pointDistance * pointDistance, 0.04);
        direct += evaluatePbrLight(baseColor,
            metallic,
            roughness,
            N,
            V,
            pointL,
            max(lightingConstants.pointColor.rgb, vec3(0.0)) * pointIntensity * attenuation);
    }

    vec3 indirectBounce = computeScreenSpaceGi(pixel, size, worldPosition, N, baseColor) * ao * (1.0 - metallic);
    vec3 ambientDiffuse = sampleDiffuseIbl(N) * baseColor * (1.0 - metallic) * ao + indirectBounce;
    vec3 reflectionColor = computeScreenSpaceReflection(pixel, size, worldPosition, N, V, sampleSpecularIbl(R, roughness), roughness, metallic);
    vec3 ambientSpecular = reflectionColor * FresnelSchlick(max(dot(N, V), 0.0), F0) * mix(0.08, 0.45, metallic) * (1.0 - roughness * 0.65);
    vec3 lit = ambientDiffuse + ambientSpecular + direct + emissive;

    imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))], pixel, vec4(lit, 1.0));
    if (pc.debugOutputImageIndex != INVALID_IMAGE_INDEX) {
        vec3 debugValue = vec3(0.0);
        if (pc.debugView == DEBUG_DIRECT_LIGHTING) {
            debugValue = direct;
        } else if (pc.debugView == DEBUG_INDIRECT_LIGHTING) {
            debugValue = ambientDiffuse;
        } else if (pc.debugView == DEBUG_REFLECTION) {
            debugValue = ambientSpecular;
        } else if (pc.debugView == DEBUG_CONTACT_SHADOW) {
            debugValue = vec3(contactShadow);
        }
        imageStore(storageImages[nonuniformEXT(int(pc.debugOutputImageIndex))], pixel, vec4(debugValue, 1.0));
    }
}
