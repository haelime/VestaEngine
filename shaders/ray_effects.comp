#version 460
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];
struct Triangle {
    vec4 p0;
    vec4 p1;
    vec4 p2;
    vec4 n0;
    vec4 n1;
    vec4 n2;
    vec4 uv0;
    vec4 uv1;
    vec4 uv2;
    vec4 baseColorFactor;
    vec4 emissiveFactor;
    vec4 materialParams;
    uvec4 textureIndices0;
    uvec4 textureIndices1;
};

layout(set = 0, binding = 2, std430) readonly buffer TriangleBuffer {
    Triangle triangles[];
} triangleBuffers[];
layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

layout(push_constant) uniform RayEffectsPushConstants {
    uint normalImageIndex;
    uint depthImageIndex;
    uint outputImageIndex;
    uint reflectionOutputImageIndex;
    uint giOutputImageIndex;
    uint giHistoryImageIndex;
    uint frameIndex;
    uint triangleBufferIndex;
    uint triangleCount;
    uint giHistoryInitialized;
    float emissionIntensity;
    uint reserved1;
    mat4 inverseViewProjection;
    vec4 cameraPosition;
    vec4 lightDirectionAndIntensity;
    uvec4 sampleCounts;
    vec4 rayParams;
    uvec4 flags;
} pc;

const uint INVALID_IMAGE_INDEX = 0xffffffffu;
const uint INVALID_RESOURCE_INDEX = 0xffffffffu;

vec3 reconstructWorldPosition(vec2 uv, float depth)
{
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world = pc.inverseViewProjection * vec4(ndc, depth, 1.0);
    return world.xyz / max(world.w, 1.0e-4);
}

float traceVisibility(vec3 origin, vec3 direction, float tMin, float tMax)
{
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq,
        topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xff,
        origin,
        tMin,
        direction,
        tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
}

vec4 traceClosestTriangle(vec3 origin, vec3 direction, float tMin, float tMax, out uint primitiveIndex, out vec2 barycentrics)
{
    primitiveIndex = INVALID_RESOURCE_INDEX;
    barycentrics = vec2(0.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq,
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xff,
        origin,
        tMin,
        direction,
        tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return vec4(0.0);
    }

    primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    barycentrics = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    return vec4(1.0);
}

uint hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float random01(uint seed)
{
    return float(hash(seed) & 0x00ffffffu) / float(0x01000000u);
}

vec3 sampleHemisphere(vec3 normal, uint sampleIndex, uint sampleCount, ivec2 pixel)
{
    uint seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.frameIndex * 26699u + sampleIndex * 7919u;
    float u = (float(sampleIndex) + random01(seed)) / max(float(sampleCount), 1.0);
    float v = random01(seed ^ 0x9e3779b9u);
    float phi = 6.28318530718 * v;
    float cosTheta = sqrt(1.0 - u);
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 local = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * local.x + bitangent * local.y + normal * local.z);
}

vec4 sampleOptional(uint textureIndex, vec2 uv, vec4 fallback)
{
    if (textureIndex == INVALID_RESOURCE_INDEX) {
        return fallback;
    }
    return fallback * texture(sampledImages[nonuniformEXT(int(textureIndex))], uv);
}

vec3 shadeHitTriangle(uint primitiveIndex, vec2 barycentrics, vec3 rayDirection)
{
    if (pc.triangleBufferIndex == INVALID_RESOURCE_INDEX || primitiveIndex >= pc.triangleCount) {
        return vec3(0.0);
    }

    Triangle tri = triangleBuffers[nonuniformEXT(int(pc.triangleBufferIndex))].triangles[primitiveIndex];
    float u = barycentrics.x;
    float v = barycentrics.y;
    float w = 1.0 - u - v;
    vec2 uv = tri.uv0.xy * w + tri.uv1.xy * u + tri.uv2.xy * v;
    vec3 normal = normalize(tri.n0.xyz * w + tri.n1.xyz * u + tri.n2.xyz * v);
    if (dot(normal, -rayDirection) < 0.0) {
        normal = -normal;
    }

    vec4 baseColorSample = sampleOptional(tri.textureIndices0.x, uv, tri.baseColorFactor);
    vec4 metallicRoughnessSample = tri.textureIndices0.y != INVALID_RESOURCE_INDEX
        ? texture(sampledImages[nonuniformEXT(int(tri.textureIndices0.y))], uv)
        : vec4(1.0);
    vec4 emissiveSample = sampleOptional(tri.textureIndices1.x, uv, tri.emissiveFactor);
    vec3 baseColor = max(baseColorSample.rgb, vec3(0.0));
    float metallic = clamp(tri.materialParams.x * metallicRoughnessSample.b, 0.0, 1.0);
    float roughness = clamp(tri.materialParams.y * metallicRoughnessSample.g, 0.045, 1.0);
    vec3 emissive = max(emissiveSample.rgb, vec3(0.0)) * max(pc.emissionIntensity, 0.0);

    vec3 viewDirection = normalize(-rayDirection);
    vec3 lightDirection = normalize(-pc.lightDirectionAndIntensity.xyz);
    vec3 halfVector = normalize(viewDirection + lightDirection);
    float nDotL = max(dot(normal, lightDirection), 0.0);
    float nDotV = max(dot(normal, viewDirection), 0.0);
    vec3 f0 = mix(vec3(0.04), baseColor, metallic);
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(halfVector, viewDirection), 0.0), 5.0);
    vec3 diffuse = baseColor * (1.0 - metallic) * 0.31830988618;
    float specPower = mix(48.0, 4.0, roughness);
    vec3 specular = fresnel * pow(max(dot(normal, halfVector), 0.0), specPower) * mix(0.35, 1.0, metallic);
    vec3 direct = (diffuse + specular) * nDotL * pc.lightDirectionAndIntensity.w;
    vec3 ambient = baseColor * mix(0.04, 0.16, clamp(normal.y * 0.5 + 0.5, 0.0, 1.0)) * (1.0 - metallic * 0.35);
    return emissive + direct + ambient;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(storageImages[nonuniformEXT(int(pc.outputImageIndex))]);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(outputSize);
    float depth = texture(sampledImages[nonuniformEXT(int(pc.depthImageIndex))], uv).r;
    if (depth >= 0.99999) {
        imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))], pixel, vec4(1.0, 1.0, 0.0, 1.0));
        if (pc.reflectionOutputImageIndex != INVALID_IMAGE_INDEX) {
            imageStore(storageImages[nonuniformEXT(int(pc.reflectionOutputImageIndex))], pixel, vec4(0.0));
        }
        if (pc.giOutputImageIndex != INVALID_IMAGE_INDEX) {
            imageStore(storageImages[nonuniformEXT(int(pc.giOutputImageIndex))], pixel, vec4(0.0));
            if (pc.giHistoryImageIndex != INVALID_IMAGE_INDEX) {
                imageStore(storageImages[nonuniformEXT(int(pc.giHistoryImageIndex))], pixel, vec4(0.0));
            }
        }
        return;
    }

    ivec2 normalSize = imageSize(storageImages[nonuniformEXT(int(pc.normalImageIndex))]);
    ivec2 normalPixel = clamp(ivec2(uv * vec2(normalSize)), ivec2(0), normalSize - ivec2(1));
    vec4 normalRoughness = imageLoad(storageImages[nonuniformEXT(int(pc.normalImageIndex))], normalPixel);
    vec3 normal = normalize(normalRoughness.xyz * 2.0 - 1.0);
    float roughness = clamp(normalRoughness.w, 0.0, 1.0);
    vec3 worldPosition = reconstructWorldPosition(uv, depth);

    vec3 rayOrigin = worldPosition + normal * 0.025;
    vec3 lightDirection = normalize(-pc.lightDirectionAndIntensity.xyz);
    float shadowVisibility = 1.0;
    if (pc.flags.x != 0u) {
        shadowVisibility = traceVisibility(rayOrigin, lightDirection, 0.03, max(pc.rayParams.x, 0.1));
    }

    float aoVisibility = 1.0;
    if (pc.flags.y != 0u) {
        uint sampleCount = clamp(pc.sampleCounts.y, 1u, 8u);
        float occlusion = 0.0;
        for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex) {
            vec3 aoDirection = sampleHemisphere(normal, sampleIndex, sampleCount, pixel);
            occlusion += 1.0 - traceVisibility(rayOrigin, aoDirection, 0.03, max(pc.rayParams.y, 0.05));
        }
        aoVisibility = clamp(1.0 - occlusion / float(sampleCount), 0.0, 1.0);
    }

    float reflectionMissVisibility = 1.0;
    vec3 reflectionHitColor = vec3(0.0);
    float reflectionHitWeight = 0.0;
    if (pc.flags.z != 0u && roughness <= pc.rayParams.z) {
        vec3 viewDirection = normalize(pc.cameraPosition.xyz - worldPosition);
        vec3 reflectionDirection = normalize(reflect(-viewDirection, normal));
        if (dot(reflectionDirection, normal) > 0.0) {
            uint sampleCount = clamp(pc.sampleCounts.z, 1u, 8u);
            float missSum = 0.0;
            for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex) {
                vec3 coneDirection = sampleHemisphere(reflectionDirection, sampleIndex, sampleCount, pixel);
                vec3 rayDirection = normalize(mix(reflectionDirection, coneDirection, clamp(roughness * 0.35, 0.0, 0.35)));
                uint primitiveIndex = INVALID_RESOURCE_INDEX;
                vec2 barycentrics = vec2(0.0);
                vec4 hit = traceClosestTriangle(rayOrigin, rayDirection, 0.03, max(pc.rayParams.x, 0.1), primitiveIndex, barycentrics);
                float miss = 1.0 - hit.x;
                missSum += miss;
                if (hit.x > 0.0) {
                    reflectionHitColor += shadeHitTriangle(primitiveIndex, barycentrics, rayDirection);
                    reflectionHitWeight += 1.0;
                }
            }
            reflectionMissVisibility = clamp(missSum / float(sampleCount), 0.0, 1.0);
        }
    }

    imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))],
        pixel,
        vec4(shadowVisibility, aoVisibility, reflectionMissVisibility, 1.0));
    if (pc.reflectionOutputImageIndex != INVALID_IMAGE_INDEX) {
        vec3 hitColor = reflectionHitWeight > 0.0 ? reflectionHitColor / reflectionHitWeight : vec3(0.0);
        float hitBlend = clamp(reflectionHitWeight / max(float(pc.sampleCounts.z), 1.0), 0.0, 1.0);
        imageStore(storageImages[nonuniformEXT(int(pc.reflectionOutputImageIndex))], pixel, vec4(hitColor, hitBlend));
    }
    if (pc.giOutputImageIndex != INVALID_IMAGE_INDEX) {
        vec3 giColor = vec3(0.0);
        float giWeight = 0.0;
        if (pc.flags.w != 0u) {
            uint sampleCount = clamp(pc.sampleCounts.w, 1u, 8u);
            float giMaxDistance = max(min(pc.rayParams.x, pc.rayParams.y * 6.0), 0.1);
            for (uint sampleIndex = 0u; sampleIndex < sampleCount; ++sampleIndex) {
                vec3 giDirection = sampleHemisphere(normal, sampleIndex + 17u, sampleCount, pixel);
                uint primitiveIndex = INVALID_RESOURCE_INDEX;
                vec2 barycentrics = vec2(0.0);
                vec4 hit = traceClosestTriangle(rayOrigin, giDirection, 0.03, giMaxDistance, primitiveIndex, barycentrics);
                if (hit.x > 0.0) {
                    giColor += shadeHitTriangle(primitiveIndex, barycentrics, giDirection);
                    giWeight += 1.0;
                }
            }
        }
        float giBlend = clamp(giWeight / max(float(pc.sampleCounts.w), 1.0), 0.0, 1.0);
        vec3 currentGi = giWeight > 0.0 ? giColor / giWeight : vec3(0.0);
        vec4 outputGi = vec4(currentGi, giBlend);
        if (pc.giHistoryImageIndex != INVALID_IMAGE_INDEX && pc.giHistoryInitialized != 0u && pc.rayParams.w > 0.0) {
            vec4 historyGi = imageLoad(storageImages[nonuniformEXT(int(pc.giHistoryImageIndex))], pixel);
            float temporalWeight = clamp(pc.rayParams.w * min(historyGi.a, 1.0), 0.0, 0.96);
            temporalWeight *= smoothstep(0.02, 0.35, giBlend);
            outputGi.rgb = mix(currentGi, historyGi.rgb, temporalWeight);
            outputGi.a = max(giBlend, historyGi.a * temporalWeight);
        }
        imageStore(storageImages[nonuniformEXT(int(pc.giOutputImageIndex))], pixel, outputGi);
        if (pc.giHistoryImageIndex != INVALID_IMAGE_INDEX) {
            imageStore(storageImages[nonuniformEXT(int(pc.giHistoryImageIndex))], pixel, outputGi);
        }
    }
}
