#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

// Hardware RT reference path tracer. Raygen owns the iterative path loop so
// bounce count, accumulation, and AOV output stay visible from one shader.

layout(set = 0, binding = 1, rgba16f) uniform image2D storageImages[];
layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(rgba16f, set = 1, binding = 1) uniform image2D outputImage;

struct Triangle {
    vec4 p0;
    vec4 p1;
    vec4 p2;
    vec4 n0;
    vec4 n1;
    vec4 n2;
    vec4 uv0;
    vec4 uv1;
    vec4 uv2;
    vec4 baseColorFactor;
    vec4 emissiveFactor;
    vec4 materialParams;
    uvec4 textureIndices0;
    uvec4 textureIndices1;
};

struct PathPayload {
    vec4 radianceDistance;
    vec4 albedoMetallic;
    vec4 normalRoughness;
    vec4 emissiveHit;
};

struct EmissiveTriangle {
    uint triangleIndex;
    float areaOverProbability;
    float cdf;
    float padding;
};

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(set = 0, binding = 2, std430) readonly buffer TriangleBuffer {
    Triangle triangles[];
} triangleBuffers[];
layout(set = 0, binding = 2, std430) readonly buffer EmissiveTriangleBuffer {
    EmissiveTriangle lights[];
} emissiveTriangleBuffers[];

layout(location = 0) rayPayloadEXT PathPayload payload;

layout(push_constant) uniform PathTracePushConstants {
    mat4 inverseViewProjection;
    vec4 cameraPositionAndFrame;
    vec4 lightDirectionAndIntensity;
    vec4 environmentParams;
    vec4 cameraRightAperture;
    vec4 cameraUpFocalDistance;
    uint triangleBufferIndex;
    uint triangleCount;
    uint frameIndex;
    uint emissiveTriangleBufferIndex;
    uint emissiveTriangleCount;
    uint reserved0;
    uint reserved1;
    uvec4 accumulationImageIndices0;
    uvec4 accumulationImageIndices1;
    uvec4 pathTraceParams;
    uvec4 guideImageIndices;
} pc;

const float PI = 3.14159265359;
const uint DEBUG_FINAL = 0u;
const uint DEBUG_ALBEDO = 1u;
const uint DEBUG_NORMAL = 2u;
const uint DEBUG_DEPTH = 3u;
const uint DEBUG_DIRECT = 4u;
const uint DEBUG_INDIRECT = 5u;
const uint kInvalidResourceIndex = 0xFFFFFFFFu;

uint accumulationImageIndex(uint debugView)
{
    if (debugView == DEBUG_FINAL) {
        return pc.accumulationImageIndices0.x;
    }
    if (debugView == DEBUG_ALBEDO) {
        return pc.accumulationImageIndices0.y;
    }
    if (debugView == DEBUG_NORMAL) {
        return pc.accumulationImageIndices0.z;
    }
    if (debugView == DEBUG_DEPTH) {
        return pc.accumulationImageIndices0.w;
    }
    if (debugView == DEBUG_DIRECT) {
        return pc.accumulationImageIndices1.x;
    }
    return pc.accumulationImageIndices1.y;
}

uint hash_u32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand(inout uint state)
{
    state = hash_u32(state);
    return float(state) * (1.0 / 4294967296.0);
}

vec3 sampleSky(vec3 direction)
{
    float c = cos(pc.environmentParams.y);
    float s = sin(pc.environmentParams.y);
    direction = normalize(vec3(c * direction.x + s * direction.z, direction.y, -s * direction.x + c * direction.z));
    float skyT = 0.5 * (direction.y + 1.0);
    vec3 sky = mix(vec3(0.08, 0.11, 0.16), vec3(0.40, 0.55, 0.82), skyT);
    float sun = pow(max(dot(direction, normalize(vec3(0.55, 0.25, 0.80))), 0.0), 64.0);
    return (sky + sun * vec3(1.35, 0.92, 0.45)) * pc.environmentParams.x;
}

vec3 cosineHemisphere(vec3 normal, inout uint rng)
{
    float u1 = rand(rng);
    float u2 = rand(rng);
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 tangent = normalize(abs(normal.y) > 0.99 ? cross(normal, vec3(1.0, 0.0, 0.0)) : cross(normal, vec3(0.0, 1.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (cos(phi) * r) + bitangent * (sin(phi) * r) + normal * sqrt(max(0.0, 1.0 - u1)));
}

vec3 sampleGGXReflection(vec3 normal, vec3 viewDir, float roughness, inout uint rng)
{
    float u1 = rand(rng);
    float u2 = rand(rng);
    float a = max(roughness * roughness, 0.002);
    float a2 = a * a;
    float phi = 2.0 * PI * u2;
    float cosTheta = sqrt((1.0 - u1) / max(1.0 + (a2 - 1.0) * u1, 1.0e-4));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 tangent = normalize(abs(normal.y) > 0.99 ? cross(normal, vec3(1.0, 0.0, 0.0)) : cross(normal, vec3(0.0, 1.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    vec3 halfVector = normalize(tangent * (cos(phi) * sinTheta) + bitangent * (sin(phi) * sinTheta) + normal * cosTheta);
    vec3 reflected = normalize(reflect(-viewDir, halfVector));
    if (dot(reflected, normal) <= 0.0) {
        reflected = cosineHemisphere(normal, rng);
    }
    return reflected;
}

vec2 sampleDisk(inout uint rng)
{
    float angle = 2.0 * PI * rand(rng);
    float radius = sqrt(rand(rng));
    return vec2(cos(angle), sin(angle)) * radius;
}

float luminance(vec3 value)
{
    return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

vec4 sampleOptional(uint textureIndex, vec2 uv, vec4 fallback)
{
    if (textureIndex == kInvalidResourceIndex) {
        return fallback;
    }
    return fallback * texture(sampledImages[nonuniformEXT(int(textureIndex))], uv);
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denominator = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / max(PI * denominator * denominator, 1.0e-4);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, 1.0e-4);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 evaluatePbrBrdf(vec3 albedo, float metallic, float roughness, vec3 normal, vec3 viewDir, vec3 lightDir)
{
    vec3 H = normalize(viewDir + lightDir);
    float NdotL = max(dot(normal, lightDir), 0.0);
    float NdotV = max(dot(normal, viewDir), 0.0);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    vec3 F = FresnelSchlick(max(dot(H, viewDir), 0.0), F0);
    float D = DistributionGGX(normal, H, roughness);
    float G = GeometrySmith(normal, viewDir, lightDir, roughness);
    vec3 specular = (D * G * F) / max(4.0 * NdotV * NdotL, 1.0e-4);
    vec3 diffuse = (vec3(1.0) - F) * (1.0 - metallic) * albedo / PI;
    return (diffuse + specular) * NdotL;
}

vec3 evaluateDirect(vec3 albedo, float metallic, float roughness, vec3 normal, vec3 viewDir)
{
    vec3 L = normalize(-pc.lightDirectionAndIntensity.xyz);
    return evaluatePbrBrdf(albedo, metallic, roughness, normal, viewDir, L) * pc.lightDirectionAndIntensity.w;
}

bool visibleToDirectionalLight(vec3 origin, vec3 normal)
{
    vec3 lightDirection = normalize(-pc.lightDirectionAndIntensity.xyz);
    if (dot(normal, lightDirection) <= 0.0) {
        return false;
    }

    payload.radianceDistance = vec4(0.0);
    payload.albedoMetallic = vec4(0.0);
    payload.normalRoughness = vec4(0.0, 1.0, 0.0, 1.0);
    payload.emissiveHit = vec4(0.0);

    traceRayEXT(topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        0,
        0,
        0,
        origin + normal * 0.004,
        0.001,
        lightDirection,
        10000.0,
        0);

    return payload.emissiveHit.w < 0.5;
}

bool visibleToPoint(vec3 origin, vec3 normal, vec3 target)
{
    vec3 toTarget = target - origin;
    float distanceToTarget = length(toTarget);
    if (distanceToTarget <= 0.01) {
        return false;
    }
    vec3 lightDirection = toTarget / distanceToTarget;
    if (dot(normal, lightDirection) <= 0.0) {
        return false;
    }

    payload.radianceDistance = vec4(0.0);
    payload.albedoMetallic = vec4(0.0);
    payload.normalRoughness = vec4(0.0, 1.0, 0.0, 1.0);
    payload.emissiveHit = vec4(0.0);

    traceRayEXT(topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        0,
        0,
        0,
        origin + normal * 0.004,
        0.001,
        lightDirection,
        max(distanceToTarget - 0.01, 0.001),
        0);

    return payload.emissiveHit.w < 0.5;
}

vec3 sampleEmissiveDirect(vec3 origin, vec3 normal, vec3 viewDir, vec3 albedo, float metallic, float roughness, inout uint rng)
{
    if (pc.emissiveTriangleCount == 0u || pc.emissiveTriangleBufferIndex == kInvalidResourceIndex) {
        return vec3(0.0);
    }

    const uint attemptCount = 4u;
    vec3 contribution = vec3(0.0);
    for (uint attempt = 0u; attempt < attemptCount; ++attempt) {
        float lightSample = rand(rng);
        uint low = 0u;
        uint high = pc.emissiveTriangleCount;
        while (low + 1u < high) {
            uint mid = (low + high) / 2u;
            float cdf = emissiveTriangleBuffers[nonuniformEXT(int(pc.emissiveTriangleBufferIndex))].lights[mid].cdf;
            if (lightSample <= cdf) {
                high = mid;
            } else {
                low = mid + 1u;
            }
        }
        uint emissiveIndex = min(low, pc.emissiveTriangleCount - 1u);
        EmissiveTriangle light = emissiveTriangleBuffers[nonuniformEXT(int(pc.emissiveTriangleBufferIndex))].lights[emissiveIndex];
        uint triangleIndex = light.triangleIndex;
        Triangle tri = triangleBuffers[nonuniformEXT(int(pc.triangleBufferIndex))].triangles[triangleIndex];
        vec3 e0 = tri.p1.xyz - tri.p0.xyz;
        vec3 e1 = tri.p2.xyz - tri.p0.xyz;
        float area = length(cross(e0, e1)) * 0.5;
        if (area <= 1.0e-6) {
            continue;
        }

        float r0 = sqrt(rand(rng));
        float r1 = rand(rng);
        float b0 = 1.0 - r0;
        float b1 = r0 * (1.0 - r1);
        float b2 = r0 * r1;
        vec3 lightPosition = tri.p0.xyz * b0 + tri.p1.xyz * b1 + tri.p2.xyz * b2;
        vec3 lightNormal = normalize(tri.n0.xyz * b0 + tri.n1.xyz * b1 + tri.n2.xyz * b2);
        vec2 lightUv = tri.uv0.xy * b0 + tri.uv1.xy * b1 + tri.uv2.xy * b2;
        vec3 emissive = sampleOptional(tri.textureIndices1.x, lightUv, tri.emissiveFactor).rgb;
        if (luminance(emissive) <= 1.0e-4) {
            continue;
        }

        vec3 toLight = lightPosition - origin;
        float distanceSquared = max(dot(toLight, toLight), 1.0e-4);
        vec3 lightDirection = normalize(toLight);
        float lightCos = max(dot(lightNormal, -lightDirection), 0.0);
        if (lightCos <= 0.0 || !visibleToPoint(origin, normal, lightPosition)) {
            continue;
        }

        vec3 brdf = evaluatePbrBrdf(albedo, metallic, roughness, normal, viewDir, lightDirection);
        contribution += brdf * emissive * lightCos * light.areaOverProbability / distanceSquared;
    }

    return contribution / float(attemptCount);
}

vec3 traceSample(vec3 origin, vec3 direction, inout uint rng, out vec3 primaryAlbedo, out vec3 primaryNormal, out float primaryDepth, out vec3 directOut)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    directOut = vec3(0.0);
    primaryAlbedo = vec3(0.0);
    primaryNormal = vec3(0.0, 1.0, 0.0);
    primaryDepth = 0.0;

    uint bounceLimit = clamp(pc.pathTraceParams.z, 1u, 12u);
    for (uint bounce = 0u; bounce < bounceLimit; ++bounce) {
        payload.radianceDistance = vec4(0.0);
        payload.albedoMetallic = vec4(0.0);
        payload.normalRoughness = vec4(0.0, 1.0, 0.0, 1.0);
        payload.emissiveHit = vec4(0.0);

        traceRayEXT(topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            0,
            0,
            0,
            origin,
            0.001,
            direction,
            10000.0,
            0);

        if (payload.emissiveHit.w < 0.5) {
            vec3 sky = payload.radianceDistance.rgb;
            radiance += throughput * sky;
            break;
        }

        vec3 albedo = payload.albedoMetallic.rgb;
        float metallic = clamp(payload.albedoMetallic.a, 0.0, 1.0);
        vec3 normal = normalize(payload.normalRoughness.xyz);
        float roughness = clamp(payload.normalRoughness.a, 0.045, 1.0);
        vec3 emissive = payload.emissiveHit.rgb;
        float hitT = payload.radianceDistance.a;
        vec3 hitPosition = origin + direction * hitT;
        vec3 viewDir = normalize(-direction);

        if (bounce == 0u) {
            primaryAlbedo = albedo;
            primaryNormal = normal;
            primaryDepth = hitT;
        }

        bool lightVisible = visibleToDirectionalLight(hitPosition, normal);
        vec3 direct = lightVisible ? evaluateDirect(albedo, metallic, roughness, normal, viewDir) : vec3(0.0);
        direct += sampleEmissiveDirect(hitPosition, normal, viewDir, albedo, metallic, roughness, rng);
        radiance += throughput * (emissive + direct);
        directOut += throughput * direct;

        vec3 F0 = mix(vec3(0.04), albedo, metallic);
        vec3 F = FresnelSchlick(max(dot(normal, viewDir), 0.0), F0);
        float specularProbability = clamp(mix(luminance(F), 1.0, metallic), 0.05, 0.95);
        if (rand(rng) < specularProbability) {
            direction = sampleGGXReflection(normal, viewDir, roughness, rng);
            throughput *= F / specularProbability;
        } else {
            direction = cosineHemisphere(normal, rng);
            vec3 diffuseWeight = albedo * (1.0 - metallic) * (vec3(1.0) - F);
            throughput *= diffuseWeight / max(1.0 - specularProbability, 0.05);
        }
        throughput = min(throughput, vec3(8.0));
        origin = hitPosition + normal * 0.002;

        if (bounce >= 3u) {
            float survive = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (rand(rng) > survive) {
                break;
            }
            throughput /= survive;
        }
    }

    return radiance;
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 size = ivec2(gl_LaunchSizeEXT.xy);
    uint rng = hash_u32(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.frameIndex * 26699u);

    vec3 accumulatedSample = vec3(0.0);
    vec3 accumulatedAlbedo = vec3(0.0);
    vec3 accumulatedNormal = vec3(0.0);
    float accumulatedDepth = 0.0;
    vec3 accumulatedDirect = vec3(0.0);
    uint spp = clamp(pc.pathTraceParams.y, 1u, 16u);

    for (uint sampleIndex = 0u; sampleIndex < spp; ++sampleIndex) {
        vec2 uv = (vec2(pixel) + vec2(rand(rng), rand(rng))) / vec2(size);
        vec2 ndc = uv * 2.0 - 1.0;
        vec4 nearPoint = pc.inverseViewProjection * vec4(ndc, 0.0, 1.0);
        vec4 farPoint = pc.inverseViewProjection * vec4(ndc, 1.0, 1.0);
        nearPoint /= nearPoint.w;
        farPoint /= farPoint.w;

        vec3 rayOrigin = pc.cameraPositionAndFrame.xyz;
        vec3 rayDirection = normalize(farPoint.xyz - nearPoint.xyz);
        if (pc.cameraRightAperture.w > 0.0 && pc.cameraUpFocalDistance.w > 0.0) {
            vec3 focalPoint = rayOrigin + rayDirection * pc.cameraUpFocalDistance.w;
            vec2 lensSample = sampleDisk(rng) * pc.cameraRightAperture.w;
            rayOrigin += pc.cameraRightAperture.xyz * lensSample.x + pc.cameraUpFocalDistance.xyz * lensSample.y;
            rayDirection = normalize(focalPoint - rayOrigin);
        }
        vec3 albedo;
        vec3 normal;
        float depth;
        vec3 direct;
        vec3 color = traceSample(rayOrigin, rayDirection, rng, albedo, normal, depth, direct);
        accumulatedSample += color;
        accumulatedAlbedo += albedo;
        accumulatedNormal += normal;
        accumulatedDepth += depth;
        accumulatedDirect += direct;
    }

    vec3 sampleColor = accumulatedSample / float(spp);
    vec3 albedoAov = accumulatedAlbedo / float(spp);
    vec3 normalAov = normalize(accumulatedNormal / float(spp)) * 0.5 + 0.5;
    float depthAov = accumulatedDepth / float(spp);
    vec3 directAov = accumulatedDirect / float(spp);
    vec3 indirectAov = max(sampleColor - directAov, vec3(0.0));

    vec3 finalColor = pc.frameIndex == 0u
        ? sampleColor
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_FINAL)))], pixel).rgb, sampleColor, 1.0 / float(pc.frameIndex + 1u));
    vec3 accumulatedAlbedoAov = pc.frameIndex == 0u
        ? albedoAov
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_ALBEDO)))], pixel).rgb, albedoAov, 1.0 / float(pc.frameIndex + 1u));
    vec3 accumulatedNormalAov = pc.frameIndex == 0u
        ? normalAov
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_NORMAL)))], pixel).rgb, normalAov, 1.0 / float(pc.frameIndex + 1u));
    vec3 accumulatedDepthAov = pc.frameIndex == 0u
        ? vec3(clamp(depthAov / 100.0, 0.0, 1.0))
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_DEPTH)))], pixel).rgb,
            vec3(clamp(depthAov / 100.0, 0.0, 1.0)),
            1.0 / float(pc.frameIndex + 1u));
    vec3 accumulatedDirectAov = pc.frameIndex == 0u
        ? directAov
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_DIRECT)))], pixel).rgb, directAov, 1.0 / float(pc.frameIndex + 1u));
    vec3 accumulatedIndirectAov = pc.frameIndex == 0u
        ? indirectAov
        : mix(imageLoad(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_INDIRECT)))], pixel).rgb,
            indirectAov,
            1.0 / float(pc.frameIndex + 1u));

    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_FINAL)))], pixel, vec4(finalColor, 1.0));
    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_ALBEDO)))], pixel, vec4(accumulatedAlbedoAov, 1.0));
    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_NORMAL)))], pixel, vec4(accumulatedNormalAov, 1.0));
    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_DEPTH)))], pixel, vec4(accumulatedDepthAov, 1.0));
    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_DIRECT)))], pixel, vec4(accumulatedDirectAov, 1.0));
    imageStore(storageImages[nonuniformEXT(int(accumulationImageIndex(DEBUG_INDIRECT)))], pixel, vec4(accumulatedIndirectAov, 1.0));

    if (pc.guideImageIndices.x != 0xffffffffu) {
        imageStore(storageImages[nonuniformEXT(int(pc.guideImageIndices.x))], pixel, vec4(accumulatedNormalAov, 1.0));
    }
    if (pc.guideImageIndices.y != 0xffffffffu) {
        imageStore(storageImages[nonuniformEXT(int(pc.guideImageIndices.y))], pixel, vec4(accumulatedDepthAov, 1.0));
    }

    vec3 outputColor = finalColor;
    uint debugView = pc.pathTraceParams.x;
    if (debugView == DEBUG_ALBEDO) {
        outputColor = accumulatedAlbedoAov;
    } else if (debugView == DEBUG_NORMAL) {
        outputColor = accumulatedNormalAov;
    } else if (debugView == DEBUG_DEPTH) {
        outputColor = accumulatedDepthAov;
    } else if (debugView == DEBUG_DIRECT) {
        outputColor = accumulatedDirectAov;
    } else if (debugView == DEBUG_INDIRECT) {
        outputColor = accumulatedIndirectAov;
    }

    imageStore(outputImage, pixel, vec4(outputColor, 1.0));
}
