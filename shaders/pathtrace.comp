#version 460
#extension GL_EXT_nonuniform_qualifier : enable

// Readable compute fallback for path tracing. It now evaluates the same
// metallic-roughness inputs as the raster path so hero assets look consistent.

layout(local_size_x = 8, local_size_y = 8) in;

struct Triangle {
    vec4 p0;
    vec4 p1;
    vec4 p2;
    vec4 n0;
    vec4 n1;
    vec4 n2;
    vec4 uv0;
    vec4 uv1;
    vec4 uv2;
    vec4 baseColorFactor;
    vec4 emissiveFactor;
    vec4 materialParams;
    vec4 opticalParams;
    uvec4 textureIndices0;
    uvec4 textureIndices1;
};

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];
layout(set = 0, binding = 2, std430) readonly buffer TriangleBuffer {
    Triangle triangles[];
} triangleBuffers[];

layout(push_constant) uniform PathTracePushConstants {
    mat4 inverseViewProjection;
    vec4 cameraPositionAndFrame;
    vec4 lightDirectionAndIntensity;
    vec4 environmentParams;
    vec4 cameraRightAperture;
    vec4 cameraUpFocalDistance;
    uint outputImageIndex;
    uint triangleBufferIndex;
    uint triangleCount;
    uint frameIndex;
    uint debugView;
    uint reserved0;
    uint reserved1;
    uint reserved2;
    uint normalGuideImageIndex;
    uint depthGuideImageIndex;
    uint reserved3;
    uint reserved4;
} pc;

const uint kInvalidResourceIndex = 0xFFFFFFFFu;
const uint DEBUG_FINAL = 0u;
const uint DEBUG_ALBEDO = 1u;
const uint DEBUG_NORMAL = 2u;
const uint DEBUG_DEPTH = 3u;
const uint DEBUG_DIRECT = 4u;
const uint DEBUG_INDIRECT = 5u;
const uint DEBUG_RAY_COUNT = 6u;
const uint DEBUG_DIFFUSE_BOUNCE = 7u;
const uint DEBUG_SPECULAR_BOUNCE = 8u;
const uint DEBUG_THROUGHPUT = 9u;
const uint DEBUG_PDF = 10u;
const uint PT_FLAG_GI = 4u;
const uint PT_FLAG_AO = 8u;
const float PI = 3.14159265359;
const float kComputeRadianceClamp = 64.0;

float sanitizeScalar(float value)
{
    if (isnan(value) || isinf(value) || value < 0.0) {
        return 0.0;
    }
    return value;
}

vec3 sanitizeColor(vec3 value)
{
    return vec3(sanitizeScalar(value.r), sanitizeScalar(value.g), sanitizeScalar(value.b));
}

vec3 clampPathContribution(vec3 value)
{
    return min(sanitizeColor(value), vec3(kComputeRadianceClamp));
}

struct HitInfo {
    float t;
    float u;
    float v;
    uint triangleIndex;
};

vec3 sampleEnvironmentMap(uint imageIndex, vec3 direction)
{
    float u = atan(direction.z, direction.x) / (2.0 * PI) + 0.5;
    float v = acos(clamp(direction.y, -1.0, 1.0)) / PI;
    return texture(sampledImages[nonuniformEXT(int(imageIndex))], vec2(u, v)).rgb * pc.environmentParams.x;
}

float rand(vec2 co) {
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

vec3 sampleSky(vec3 direction)
{
    float c = cos(pc.environmentParams.y);
    float s = sin(pc.environmentParams.y);
    direction = normalize(vec3(c * direction.x + s * direction.z, direction.y, -s * direction.x + c * direction.z));
    if (pc.reserved0 != kInvalidResourceIndex) {
        return sampleEnvironmentMap(pc.reserved0, direction);
    }
    float skyT = 0.5 * (direction.y + 1.0);
    uint preset = uint(clamp(pc.environmentParams.z + 0.5, 0.0, 3.0));
    vec3 horizon = vec3(0.08, 0.11, 0.16);
    vec3 zenith = vec3(0.40, 0.55, 0.82);
    vec3 sunColor = vec3(1.35, 0.92, 0.45);
    if (preset == 1u) {
        horizon = vec3(0.20, 0.18, 0.16);
        zenith = vec3(0.78, 0.62, 0.38);
        sunColor = vec3(1.85, 0.88, 0.38);
    } else if (preset == 2u) {
        horizon = vec3(0.025, 0.032, 0.048);
        zenith = vec3(0.12, 0.17, 0.26);
        sunColor = vec3(0.48, 0.66, 1.15);
    } else if (preset == 3u) {
        horizon = vec3(0.12, 0.14, 0.13);
        zenith = vec3(0.36, 0.44, 0.38);
        sunColor = vec3(0.74, 0.86, 0.68);
    }
    vec3 sky = mix(horizon, zenith, skyT);
    float sunPower = preset == 2u ? 96.0 : 64.0;
    float sun = pow(max(dot(direction, normalize(vec3(0.55, 0.25, 0.80))), 0.0), sunPower);
    return (sky + sun * sunColor) * pc.environmentParams.x;
}

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;
    float denominator = (NdotH2 * (a2 - 1.0) + 1.0);
    return a2 / max(PI * denominator * denominator, 1.0e-4);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, 1.0e-4);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) * GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 sampleHemisphere(vec3 normal, vec2 seed) {
    float z = rand(seed);
    float angle = 6.2831853 * rand(seed.yx + 0.37);
    float r = sqrt(max(0.0, 1.0 - z * z));
    vec3 tangent = normalize(abs(normal.y) > 0.99 ? cross(normal, vec3(1.0, 0.0, 0.0)) : cross(normal, vec3(0.0, 1.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * cos(angle) * r + bitangent * sin(angle) * r + normal * z);
}

vec2 sampleDisk(vec2 seed)
{
    float angle = 6.2831853 * rand(seed + 0.71);
    float radius = sqrt(rand(seed.yx + 1.37));
    return vec2(cos(angle), sin(angle)) * radius;
}

bool intersectTriangle(vec3 ro, vec3 rd, Triangle tri, out float tHit, out float uHit, out float vHit) {
    vec3 v0 = tri.p0.xyz;
    vec3 v1 = tri.p1.xyz;
    vec3 v2 = tri.p2.xyz;
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 p = cross(rd, edge2);
    float det = dot(edge1, p);
    if (abs(det) < 1e-6) {
        return false;
    }

    float invDet = 1.0 / det;
    vec3 t = ro - v0;
    float u = dot(t, p) * invDet;
    if (u < 0.0 || u > 1.0) {
        return false;
    }

    vec3 q = cross(t, edge1);
    float v = dot(rd, q) * invDet;
    if (v < 0.0 || u + v > 1.0) {
        return false;
    }

    float hit = dot(edge2, q) * invDet;
    if (hit <= 0.001) {
        return false;
    }

    tHit = hit;
    uHit = u;
    vHit = v;
    return true;
}

vec4 sampleOptional(uint textureIndex, vec2 uv, vec4 fallback)
{
    if (textureIndex == kInvalidResourceIndex) {
        return fallback;
    }
    return fallback * texture(sampledImages[nonuniformEXT(int(textureIndex))], uv);
}

vec3 shadeTriangle(Triangle tri,
    vec3 ro,
    vec3 rd,
    float u,
    float v,
    vec2 seed,
    out vec3 albedoOut,
    out vec3 normalOut,
    out vec3 directOut,
    out vec3 diffuseBounceOut,
    out vec3 specularBounceOut,
    out vec3 throughputOut,
    out float pdfOut)
{
    float w = 1.0 - u - v;
    vec2 uv = tri.uv0.xy * w + tri.uv1.xy * u + tri.uv2.xy * v;
    vec3 N = normalize(tri.n0.xyz * w + tri.n1.xyz * u + tri.n2.xyz * v);
    vec3 V = normalize(-rd);
    vec3 L = normalize(-pc.lightDirectionAndIntensity.xyz);
    vec3 H = normalize(V + L);

    vec4 baseColorSample = sampleOptional(tri.textureIndices0.x, uv, tri.baseColorFactor);
    vec4 metallicRoughnessSample = tri.textureIndices0.y != kInvalidResourceIndex
        ? texture(sampledImages[nonuniformEXT(int(tri.textureIndices0.y))], uv)
        : vec4(1.0);
    vec4 emissiveSample = sampleOptional(tri.textureIndices1.x, uv, tri.emissiveFactor);

    vec3 baseColor = baseColorSample.rgb;
    float metallic = clamp(tri.materialParams.x * metallicRoughnessSample.b, 0.0, 1.0);
    float roughness = clamp(tri.materialParams.y * metallicRoughnessSample.g, 0.045, 1.0);
    bool globalIlluminationEnabled = (pc.reserved1 & PT_FLAG_GI) != 0u;
    bool ambientOcclusionEnabled = (pc.reserved1 & PT_FLAG_AO) != 0u;
    float ao = ambientOcclusionEnabled && tri.textureIndices0.w != kInvalidResourceIndex
        ? mix(1.0, texture(sampledImages[nonuniformEXT(int(tri.textureIndices0.w))], uv).r, tri.materialParams.z)
        : 1.0;
    vec3 emissive = emissiveSample.rgb * max(pc.environmentParams.w, 0.0);
    float transmission = clamp(tri.opticalParams.x, 0.0, 1.0);

    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    vec3 F0 = mix(vec3(0.04), baseColor, metallic);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);
    if (transmission > 0.01) {
        float ior = clamp(tri.opticalParams.y, 1.01, 2.5);
        float dielectricF0 = pow((ior - 1.0) / max(ior + 1.0, 1.0e-4), 2.0);
        float fresnel = dielectricF0 + (1.0 - dielectricF0) * pow(1.0 - NdotV, 5.0);
        vec3 refracted = refract(rd, N, 1.0 / ior);
        if (dot(refracted, refracted) <= 1.0e-6) {
            refracted = reflect(rd, N);
            fresnel = 1.0;
        }
        vec3 glassTint = mix(vec3(1.0), clamp(baseColor, vec3(0.02), vec3(1.0)), 0.35);
        vec3 refractedSky = sampleSky(normalize(refracted)) * glassTint;
        vec3 reflectedSky = sampleSky(reflect(rd, N));
        albedoOut = glassTint;
        normalOut = N;
        directOut = vec3(0.0);
        diffuseBounceOut = refractedSky * (1.0 - fresnel);
        specularBounceOut = reflectedSky * fresnel;
        throughputOut = glassTint;
        pdfOut = 1.0;
        return mix(refractedSky, reflectedSky, fresnel) + emissive;
    }
    float D = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 specular = (D * G * F) / max(4.0 * NdotV * NdotL, 1.0e-4);

    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - metallic);
    vec3 diffuse = kD * baseColor / PI;
    vec3 direct = (diffuse + specular) * NdotL * pc.lightDirectionAndIntensity.w;

    vec3 reflectedSky = sampleSky(reflect(-V, N));
    vec3 ambientDiffuse = globalIlluminationEnabled ? sampleSky(N) * baseColor * (1.0 - metallic) * 0.20 * ao : vec3(0.0);
    vec3 ambientSpecular = reflectedSky * FresnelSchlick(max(dot(N, V), 0.0), F0) * mix(0.08, 0.45, metallic) * (1.0 - roughness * 0.65);

    vec3 bounceDir = sampleHemisphere(N, seed);
    vec3 bounceColor = globalIlluminationEnabled ? sampleSky(bounceDir) * baseColor * (1.0 - metallic) * 0.12 * ao : vec3(0.0);

    albedoOut = baseColor;
    normalOut = N;
    directOut = direct;
    diffuseBounceOut = ambientDiffuse + bounceColor;
    specularBounceOut = ambientSpecular;
    throughputOut = clamp(baseColor * (1.0 - metallic) + F * metallic, vec3(0.0), vec3(1.0));
    pdfOut = max(dot(N, bounceDir), 0.0) / PI;

    return ambientDiffuse + ambientSpecular + direct + bounceColor + emissive;
}

vec3 traceScene(vec3 ro,
    vec3 rd,
    vec2 seed,
    out vec3 albedoOut,
    out vec3 normalOut,
    out float depthOut,
    out vec3 directOut,
    out vec3 diffuseBounceOut,
    out vec3 specularBounceOut,
    out vec3 throughputOut,
    out float pdfOut,
    out float rayCostOut) {
    HitInfo hit;
    hit.t = 1e20;
    hit.u = 0.0;
    hit.v = 0.0;
    hit.triangleIndex = 0u;
    bool found = false;
    rayCostOut = 1.0;

    for (uint i = 0; i < pc.triangleCount; ++i) {
        float t = 0.0;
        float u = 0.0;
        float v = 0.0;
        Triangle tri = triangleBuffers[nonuniformEXT(int(pc.triangleBufferIndex))].triangles[i];
        if (intersectTriangle(ro, rd, tri, t, u, v) && t < hit.t) {
            hit.t = t;
            hit.u = u;
            hit.v = v;
            hit.triangleIndex = i;
            found = true;
        }
    }

    if (!found) {
        albedoOut = vec3(0.0);
        normalOut = vec3(0.5, 0.5, 1.0);
        depthOut = 0.0;
        directOut = vec3(0.0);
        diffuseBounceOut = sampleSky(rd);
        specularBounceOut = vec3(0.0);
        throughputOut = vec3(1.0);
        pdfOut = 0.0;
        return sampleSky(rd);
    }

    Triangle tri = triangleBuffers[nonuniformEXT(int(pc.triangleBufferIndex))].triangles[hit.triangleIndex];
    depthOut = hit.t;
    return shadeTriangle(tri, ro, rd, hit.u, hit.v, seed, albedoOut, normalOut, directOut, diffuseBounceOut, specularBounceOut, throughputOut, pdfOut);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storageImages[nonuniformEXT(int(pc.outputImageIndex))]);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 jitter = vec2(rand(vec2(pixel) + pc.cameraPositionAndFrame.w), rand(vec2(pixel.yx) + pc.cameraPositionAndFrame.w)) / vec2(size);
    vec2 ndc = (uv + jitter) * 2.0 - 1.0;
    vec4 nearPoint = pc.inverseViewProjection * vec4(ndc, 0.0, 1.0);
    vec4 farPoint = pc.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    nearPoint /= nearPoint.w;
    farPoint /= farPoint.w;

    vec3 rayOrigin = pc.cameraPositionAndFrame.xyz;
    vec3 rayDirection = normalize(farPoint.xyz - nearPoint.xyz);
    if (pc.cameraRightAperture.w > 0.0 && pc.cameraUpFocalDistance.w > 0.0) {
        vec3 focalPoint = rayOrigin + rayDirection * pc.cameraUpFocalDistance.w;
        vec2 lensSample = sampleDisk(vec2(pixel) + pc.cameraPositionAndFrame.w) * pc.cameraRightAperture.w;
        rayOrigin += pc.cameraRightAperture.xyz * lensSample.x + pc.cameraUpFocalDistance.xyz * lensSample.y;
        rayDirection = normalize(focalPoint - rayOrigin);
    }
    vec3 albedo;
    vec3 normal;
    float depth;
    vec3 direct;
    vec3 diffuseBounce;
    vec3 specularBounce;
    vec3 throughput;
    float pdf;
    float rayCost;
    vec3 color = clampPathContribution(traceScene(rayOrigin,
        rayDirection,
        vec2(pixel) + pc.cameraPositionAndFrame.w,
        albedo,
        normal,
        depth,
        direct,
        diffuseBounce,
        specularBounce,
        throughput,
        pdf,
        rayCost));
    direct = clampPathContribution(direct);
    diffuseBounce = clampPathContribution(diffuseBounce);
    specularBounce = clampPathContribution(specularBounce);
    vec3 indirect = max(color - direct, vec3(0.0));

    vec3 outputColor = color;
    if (pc.debugView == DEBUG_ALBEDO) {
        outputColor = albedo;
    } else if (pc.debugView == DEBUG_NORMAL) {
        outputColor = normalize(normal) * 0.5 + 0.5;
    } else if (pc.debugView == DEBUG_DEPTH) {
        outputColor = vec3(clamp(depth / 100.0, 0.0, 1.0));
    } else if (pc.debugView == DEBUG_DIRECT) {
        outputColor = direct;
    } else if (pc.debugView == DEBUG_INDIRECT) {
        outputColor = indirect;
    } else if (pc.debugView == DEBUG_RAY_COUNT) {
        outputColor = vec3(clamp(rayCost / 24.0, 0.0, 1.0));
    } else if (pc.debugView == DEBUG_DIFFUSE_BOUNCE) {
        outputColor = diffuseBounce;
    } else if (pc.debugView == DEBUG_SPECULAR_BOUNCE) {
        outputColor = specularBounce;
    } else if (pc.debugView == DEBUG_THROUGHPUT) {
        outputColor = throughput;
    } else if (pc.debugView == DEBUG_PDF) {
        outputColor = vec3(clamp(pdf, 0.0, 1.0));
    }
    if (pc.normalGuideImageIndex != kInvalidResourceIndex) {
        imageStore(storageImages[nonuniformEXT(int(pc.normalGuideImageIndex))], pixel, vec4(normalize(normal) * 0.5 + 0.5, 1.0));
    }
    if (pc.depthGuideImageIndex != kInvalidResourceIndex) {
        imageStore(storageImages[nonuniformEXT(int(pc.depthGuideImageIndex))], pixel, vec4(vec3(clamp(depth / 100.0, 0.0, 1.0)), 1.0));
    }
    imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))], pixel, vec4(clampPathContribution(outputColor), 1.0));
}
