#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sampledImages[];
layout(rgba16f, set = 0, binding = 1) uniform image2D storageImages[];

layout(push_constant) uniform PathDenoisePushConstants {
    uint inputImageIndex;
    uint outputImageIndex;
    uint normalGuideImageIndex;
    uint depthGuideImageIndex;
    uint historyImageIndex;
    uint frameIndex;
    float strength;
    float temporalBlend;
    float normalSigma;
    float depthSigma;
    uint iterations;
    uint reserved1;
} pc;

float luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

float sanitizeChannel(float value)
{
    if (isnan(value) || isinf(value) || value < 0.0) {
        return 0.0;
    }
    return min(value, 64.0);
}

vec3 sanitizeColor(vec3 color)
{
    return vec3(sanitizeChannel(color.r), sanitizeChannel(color.g), sanitizeChannel(color.b));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(storageImages[nonuniformEXT(int(pc.outputImageIndex))]);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec3 center = sanitizeColor(imageLoad(storageImages[nonuniformEXT(int(pc.inputImageIndex))], pixel).rgb);
    vec3 centerNormal = imageLoad(storageImages[nonuniformEXT(int(pc.normalGuideImageIndex))], pixel).rgb * 2.0 - 1.0;
    float centerDepth = imageLoad(storageImages[nonuniformEXT(int(pc.depthGuideImageIndex))], pixel).r;
    float centerLum = luminance(center);
    vec3 filtered = center;
    vec3 neighborhoodMin = center;
    vec3 neighborhoodMax = center;
    uint iterationCount = clamp(pc.iterations, 1u, 5u);
    for (uint iteration = 0u; iteration < iterationCount; ++iteration) {
        int stepWidth = int(1u << iteration);
        vec3 sum = filtered;
        float weightSum = 1.0;

        for (int y = -2; y <= 2; ++y) {
            for (int x = -2; x <= 2; ++x) {
                if (x == 0 && y == 0) {
                    continue;
                }

                ivec2 samplePixel = clamp(pixel + ivec2(x, y) * stepWidth, ivec2(0), size - ivec2(1));
                vec3 sampleColor = sanitizeColor(imageLoad(storageImages[nonuniformEXT(int(pc.inputImageIndex))], samplePixel).rgb);
                vec3 sampleNormal = imageLoad(storageImages[nonuniformEXT(int(pc.normalGuideImageIndex))], samplePixel).rgb * 2.0 - 1.0;
                float sampleDepth = imageLoad(storageImages[nonuniformEXT(int(pc.depthGuideImageIndex))], samplePixel).r;
                neighborhoodMin = min(neighborhoodMin, sampleColor);
                neighborhoodMax = max(neighborhoodMax, sampleColor);
                float spatial = exp(-float(x * x + y * y) * 0.35);
                float range = exp(-abs(luminance(sampleColor) - centerLum) * 6.0);
                float normalWeight = exp(-(1.0 - clamp(dot(centerNormal, sampleNormal), 0.0, 1.0)) * pc.normalSigma);
                float depthWeight = exp(-abs(sampleDepth - centerDepth) * pc.depthSigma);
                float weight = spatial * range * normalWeight * depthWeight;
                sum += sampleColor * weight;
                weightSum += weight;
            }
        }
        vec3 iterationColor = sanitizeColor(sum / max(weightSum, 1.0e-4));
        float iterationStrength = clamp(pc.strength, 0.0, 1.0) / float(iterationCount);
        filtered = sanitizeColor(mix(filtered, iterationColor, iterationStrength));
    }

    vec3 spatialColor = sanitizeColor(mix(center, filtered, clamp(pc.strength, 0.0, 1.0)));
    vec3 historyColor = sanitizeColor(imageLoad(storageImages[nonuniformEXT(int(pc.historyImageIndex))], pixel).rgb);
    vec3 historySlack = max(abs(neighborhoodMax - neighborhoodMin) * 0.25, vec3(0.05));
    historyColor = clamp(historyColor, neighborhoodMin - historySlack, neighborhoodMax + historySlack);
    vec3 outputColor = pc.frameIndex == 0u
        ? spatialColor
        : sanitizeColor(mix(spatialColor, historyColor, clamp(pc.temporalBlend, 0.0, 0.98)));
    imageStore(storageImages[nonuniformEXT(int(pc.outputImageIndex))], pixel, vec4(outputColor, 1.0));
    imageStore(storageImages[nonuniformEXT(int(pc.historyImageIndex))], pixel, vec4(outputColor, 1.0));
}
